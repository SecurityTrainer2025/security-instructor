MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/security_instructor
FRONTEND_URL=https://securitytrainer2025.github.io
FRONTEND_PUBLIC_URL=https://securitytrainer2025.github.io/security-instructor/frontend
PORT=5000

# Administrator access for the private admin API
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional SMTP settings (for example, Brevo SMTP relay)
MAIL_FROM=verified-sender@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key

# Staging only: set this to the Render-hosted learner preview URL.
# Leave unset in production to retain the public learner page as the default.
AVS_WORKSHOP_FRONTEND_URL=https://security-instructor-staging.onrender.com/staging/avs-emrg-2026.html

# Alternative Microsoft Outlook OAuth2 configuration (used when SMTP_* settings are not complete)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
