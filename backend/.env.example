MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/security_instructor
FRONTEND_URL=https://securitytrainer2025.github.io
FRONTEND_PUBLIC_URL=https://securitytrainer2025.github.io/security-instructor/frontend
PORT=5000

# Optional Microsoft Outlook OAuth2 mail settings used for course-access and certificate emails
MAIL_FROM=training@example.com
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=

# SI admin account settings for Staging only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Existing Brevo sender used for workshop access invitations
BREVO_API_KEY=add-the-Brevo-API-key-in-Render-secrets
# MAIL_FROM must be a sender verified in your Brevo account
# Keep the currently verified sender from your SI mail setup.

# Staging only: private learner links must point to the Staging preview.
# Leave this unset in production to retain the public learner page as the default.
AVS_WORKSHOP_FRONTEND_URL=https://security-instructor-staging.onrender.com/staging/avs-emrg-2026.html
